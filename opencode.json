{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "experimental.continue_loop_on_deny": false
  },
  "agent": {
    "build": {
      "model": "anthropic/claude-opus-5"
    },
    "plan": {
      "model": "anthropic/claude-opus-5"
    },
    "general": {
      "model": "anthropic/claude-sonnet-5"
    },
    "explore": {
      "model": "anthropic/claude-haiku-4-5"
    },
    "scout": {
      "model": "anthropic/claude-haiku-4-5"
    },
    "compaction": {
      "model": "anthropic/claude-opus-5"
    }
  },
  "permission": {
    "*": "ask",
    "edit *": "ask",
    "read *": "allow",
    "glob *": "allow",
    "grep *": "allow",
    "todowrite": "allow",
    "sort *": "allow",
    "todoread": "allow",
    "task": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "ask",
      "bd *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "sed *": "allow",
      "head *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "ls *": "allow",
      "make *": "allow",
      "kubectl get *": "allow",
      "kubectl describe *": "allow",
      "rg *": "allow"
    }
  }
}
