{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "experimental.continue_loop_on_deny": true
  },
  "agent": {
    "build": {
      "model": "amazon-bedrock/qwen.qwen3-coder-next"
    },
    "plan": {
      "model": "amazon-bedrock/qwen.qwen3-coder-next"
    }
  },
  "permission": {
    "*": "deny",
    "edit *": "ask",
    "read *": "allow",
    "glob *": "allow",
    "grep *": "allow",
    "todowrite": "allow",
    "sort *": "allow",
    "todoread": "allow",
    "task": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "deny",
      "bd *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "sed *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "make *": "allow",
      "kubectl get *": "allow",
      "kubectl describe *": "allow",
      "rg *": "allow",
      "fd *": "allow"
    }
  }
}
