{
  "$schema": "https://opencode.ai/config.json",
  "mode": {
    "teach": {
      "prompt": "{file:~/repos/dotfiles/opencode_teacher_mode.txt}"
    }
  },
  "permission": {
    "*": "ask",
    "Read *": "allow",
    "Edit *": "allow",
    "Glob *": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "bash": {
      "*": "ask",
      "head *": "allow"
    }
  }
}
